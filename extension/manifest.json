{
  "manifest_version": 3,
  "name": "Corner Spotter - Bet365",
  "version": "1.0.0",
  "description": "Identifica jogos com altas probabilidades de escanteios na Bet365",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.bet365.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.bet365.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
